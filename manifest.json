{
  "manifest_version": 3,
  "name": "Minimalist Birthday & Milestone Countdown",
  "version": "1.3.0",
  "description": "A simple local countdown dashboard for your birthday and milestones.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.exa.ai/*",
    "https://en.wikipedia.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Manage countdowns",
    "default_popup": "popup.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/",
        "https://www.google.ca/"
      ],
      "js": [
        "shared-storage.js",
        "countdown.js",
        "google-homepage.js"
      ],
      "css": [
        "google-homepage.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
