{
  "manifest_version": 3,
  "name": "Minimalist Birthday & Milestone Countdown",
  "version": "1.0.0",
  "description": "A simple local countdown dashboard for your birthday and milestones.",
  "permissions": [
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/",
        "https://www.google.ca/"
      ],
      "js": [
        "google-homepage.js"
      ],
      "css": [
        "google-homepage.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
